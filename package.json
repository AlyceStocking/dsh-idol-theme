{
  "name": "dsh-idol-theme",
  "version": "1.3.0-desktop.5",
  "private": true,
  "description": "Windows 偶像主题试验版：190 位角色目录、独立桌宠与会话提醒。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "desktop",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:preview": "node scripts/preview-desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop:sync": "node scripts/sync-desktop.mjs",
    "build:characters": "node scripts/build-characters.mjs",
    "audit:roster": "node scripts/audit-roster.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
}
